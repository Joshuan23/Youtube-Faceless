# ════════════════════════════════════════════════════════
#  COMPLETELY FREE STACK  (no credit card required)
# ════════════════════════════════════════════════════════
#
#  1. Get Groq key (free):  https://console.groq.com
#  2. Install edge-tts:     pip install edge-tts
#  3. That's it — run:      python start.py step1
#
# ════════════════════════════════════════════════════════

# ── LLM – pick ONE (Groq is free, no card needed) ────────────────────────────
GROQ_API_KEY=gsk_...                     # FREE  https://console.groq.com
# GEMINI_API_KEY=AIza...                 # FREE  https://aistudio.google.com/apikey
# ANTHROPIC_API_KEY=sk-ant-...           # paid  https://console.anthropic.com
# OPENAI_API_KEY=sk-...                  # paid  https://platform.openai.com

# ── Voice – edge-tts is free (auto-detected, no key needed) ─────────────────
# Kid-friendly voices: en-US-AnaNeural (child) | en-US-JennyNeural | en-GB-MaisieNeural
# Leave unset to use tts.edge_voice from config.yaml (default: en-US-AnaNeural)
# EDGE_TTS_VOICE=en-US-AnaNeural

# Upgrade to ElevenLabs for singing-quality voice (optional):
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── Stock Footage (free, optional — colorful clips) ──────────────────────────
PEXELS_API_KEY=...              # FREE  https://www.pexels.com/api

# ── YouTube Upload ────────────────────────────────────────────────────────────
YOUTUBE_CLIENT_SECRETS_FILE=credentials/client_secrets.json

# ── Channel ───────────────────────────────────────────────────────────────────
CHANNEL_NICHE=nursery_rhymes
CHANNEL_NAME=Twinkle Tots
UPLOAD_SCHEDULE=5x_week
